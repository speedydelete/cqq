{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "target": "ESNext",
        "sourceMap": true,
        "declaration": true,
        "strict": true,
        "lib": ["ESNext", "DOM"],
        "module": "NodeNext",
        "resolveJsonModule": true,
        "types": ["node"],
        "noUnusedLocals": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
    },
    "include": ["./src/**/*.ts"]
}