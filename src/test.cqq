
template<^ owned>
class string {
    char* ptr;
    size len;
    // owned constructor
    ^this(size len) {
        ptr = __builtin_malloc(char, len);
        this.len = len;
    }
    // non-owned constructor
    this(char* ptr, size len) {
        this.ptr = ptr;
        this.len = len;
    }
    // destructor
    ~this() {
        if owned {
            __builtin_free(ptr);
        }
    }
    // indexing
    // does NOT error: the lifetime of the return type
    // is equal to the lifetime of the class
    char& operator[](size i) {
        return *(ptr + i);
    }
    // OR MAYBE SOMETHING LIKE THIS
    // i'm still figuring it out
    (declinfo(this).scope(char))& operator[](size i) {
        return *(ptr + i);
    }
}
